+	document.body.append(hint);
+	let start = null, ready = false;
+	const pts = (e) => [...e.touches].slice(0, 2).map((t) => [t.clientX, t.clientY]);
+	const gap = (p) => Math.hypot(p[0][0] - p[1][0], p[0][1] - p[1][1]);
