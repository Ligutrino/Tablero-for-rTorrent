+++ b/src/core/download.cc	2026-11-25 00:33:32.764467735 +0000
@@ -32,6 +32,17 @@
   m_download = download_type();
 }
 
+int64_t
+Download::sequential() {
+  return m_download.is_sequential() ? 1 : 0;
+}
+
+void
+Download::set_sequential(int64_t v) {
+  m_download.set_sequential(v != 0);
+  bencode()->get_key("rtorrent").insert_key("sequential", (int64_t)(v != 0));
+}
+
 uint32_t
 Download::priority() {
   return bencode()->get_key("rtorrent").get_key_value("priority");
